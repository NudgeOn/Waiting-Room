{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:waiting-room:cost-input:v1",
  "title": "User-entered prices for reference compute and volume subtotals only",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion","provider","regionId","currency","asOf","fractionDigits","monthlyHours","standardHostHourly","highWorkerHourly","volumeGiBMonthly","highWorkerVolumeGiB","expectedEgressGiB"],
  "properties": {
    "schemaVersion": {"const": 1},
    "provider": {"$ref": "#/$defs/slug"},
    "regionId": {"$ref": "#/$defs/slug"},
    "currency": {"type":"string","pattern":"^[A-Z]{3}$","minLength":3,"maxLength":3},
    "asOf": {"type":"string","format":"date","pattern":"^[2-9][0-9]{3}-[0-9]{2}-[0-9]{2}$","minLength":10,"maxLength":10},
    "fractionDigits": {"type":"integer","minimum":0,"maximum":4},
    "monthlyHours": {"type":"integer","minimum":1,"maximum":744},
    "standardHostHourly": {"$ref":"#/$defs/price"},
    "highWorkerHourly": {"$ref":"#/$defs/price"},
    "volumeGiBMonthly": {"$ref":"#/$defs/price"},
    "highWorkerVolumeGiB": {"type":"integer","minimum":1,"maximum":65536},
    "expectedEgressGiB": {"type":"integer","minimum":0,"maximum":1000000000}
  },
  "$defs": {
    "slug": {"type":"string","pattern":"^[a-z][a-z0-9-]{0,62}$","not":{"pattern":"[^a-z0-9-]"}},
    "price": {"type":"string","pattern":"^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,6})?$","not":{"pattern":"[^0-9.]"}}
  }
}
