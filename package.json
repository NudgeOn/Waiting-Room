{
  "name": "waiting-room-devtools",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint:api": "redocly lint api/openapi/public-v1.yaml api/openapi/admin-v1.yaml",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build:admin": "vite build --config apps/admin/vite.config.mjs",
    "test:admin-ui": "node --test apps/admin/test/*.test.mjs",
    "test:admin-browser": "go build -o build/wr-admin-lab ./cmd/wr-admin-lab && playwright test --config playwright.admin.config.mjs",
    "test:preview-browser": "go build -o build/wrctl ./cmd/wrctl && playwright test --config playwright.preview.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.51.2",
    "ajv": "8.20.0",
    "vite": "8.2.2",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
